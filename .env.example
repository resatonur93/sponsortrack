# Uzak Postgres: çoğu sağlayıcı SSL ister → sona ?sslmode=require ekleyin
DATABASE_URL="postgresql://user:password@localhost:5432/sponsortrack"
NEXTAUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# /admin ve /api/admin yalnızca bu e-posta + AUTHORISING_OFFICER rolü
ADMIN_PANEL_EMAIL="resatonurkurt@gmail.com"
CRON_SECRET="replace-with-cron-secret"
# İsteğe bağlı: /register ile yeni şirket kaydı (uzun rastgele değer)
# REGISTRATION_SECRET=""
#
# Belge süre hatırlatma e-postaları (UTC güne göre; her tetik için yalnızca bir mail)
# - Bitiş tarihine tam 30 gün kala  · tam 7 gün kala  · son geçerlilik günü  · süre dolduktan sonra
# Günlük /api/cron/run veya yüklemede uygun tarih yakalanırsa gönderilir.
# Gönderen (From): varsayılan info@sponsortrack.co.uk — SMTP_FROM ile değiştirilebilir
# Alıcı: kiracının aktif Authorising Officer kullanıcı e-postaları; yoksa DOCUMENT_EXPIRY_NOTIFY_TO
#
# DOCUMENT_EXPIRY_NOTIFY_TO="yedek@sirket.com"
#
# Hostinger giden SMTP (465, SSL implicit):
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="info@sponsortrack.co.uk"
# SMTP_PASS="postakutusu-parolasi"
# SMTP_FROM="info@sponsortrack.co.uk"
#
# Alternatif: tek satır bağlantı
# SMTP_URL="smtps://info@sponsortrack.co.uk:SIFRE@smtp.hostinger.com:465"

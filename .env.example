# Uzak Postgres: çoğu sağlayıcı SSL ister → sona ?sslmode=require ekleyin
DATABASE_URL="postgresql://user:password@localhost:5432/sponsortrack"
NEXTAUTH_SECRET="replace-with-long-random-string"
# Yerelde http://localhost:3000; production’da https ile tam canonical URL — sondaki / kullanmayın (uyarıyı kaldırır)
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://sponsortrack.co.uk"
# /admin ve /api/admin yalnızca bu e-posta + AUTHORISING_OFFICER rolü
ADMIN_PANEL_EMAIL="resatonurkurt@gmail.com"
CRON_SECRET="replace-with-cron-secret"
# İsteğe bağlı: /register ile yeni şirket kaydı (uzun rastgele değer)
# REGISTRATION_SECRET=""
#
# Belge süre hatırlatma e-postaları (UTC güne göre; her tetik için yalnızca bir mail)
# - Bitiş tarihine tam 60 gün kala  · tam 30 gün kala  · tam 7 gün kala  · son geçerlilik günü  · süre dolduktan sonra
# Günlük /api/cron/run veya yüklemede uygun tarih yakalanırsa gönderilir.
# Gönderen (From): varsayılan info@sponsortrack.co.uk — SMTP_FROM ile değiştirilebilir
# Alıcı: kiracının aktif Authorising Officer kullanıcı e-postaları; yoksa DOCUMENT_EXPIRY_NOTIFY_TO
# veya NOTIFICATION_EXPIRY_NOTIFY_TO (TR+EN uyumluluk: vize, RTW, sponsorluk / CoS ankerleri).
#
# DOCUMENT_EXPIRY_NOTIFY_TO="yedek@sirket.com"
# NOTIFICATION_EXPIRY_NOTIFY_TO="yedek@sirket.com"
#
# Hostinger giden SMTP (465, SSL implicit):
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="info@sponsortrack.co.uk"
# SMTP_PASS=";B1k@*|k7o2"
# SMTP_FROM="info@sponsortrack.co.uk"
#
# Alternatif: tek satır bağlantı
# SMTP_URL="smtps://info@sponsortrack.co.uk:SIFRE@smtp.hostinger.com:465"
#
# Belge kasası (hangisi doluysa o kullanılır; Supabase önce):
# — Supabase Storage: Dashboard → Storage → yeni bucket oluştur, “Public bucket” aç (Open link’ler çalışsın diye).
# — CORS: Allowed origin https://sponsortrack.co.uk (veya kendi domain).
# Üçü birden dolu olmalı; sadece NEXT_PUBLIC_* publishable key yeterli DEĞİL.
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# Üretim (Docker/Nixpacks): AYNI adresi SUPABASE_URL ile de ver — build sırasında NEXT_PUBLIC gömülmediyse depolama boş kalmasın:
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbG... service_role (Project Settings → API — anon değil)"
# SUPABASE_STORAGE_BUCKET="documents"
#
# AWS S3 doğrudan yükleme (Supabase yoksa) — dört değişken zorunlu:
# S3_REGION="eu-west-2"
# S3_BUCKET="sponsortrack-docs"
# S3_ACCESS_KEY_ID="AKIA..."
# S3_SECRET_ACCESS_KEY="..."
# İsteğe bağlı: CDN veya virtual-host URL (yoksa https://{bucket}.s3.{region}.amazonaws.com/... kullanılır)
# S3_PUBLIC_BASE_URL="https://sponsortrack-docs.s3.eu-west-2.amazonaws.com"

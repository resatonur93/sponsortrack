enum RtwCheckMethod {
  ONLINE_SHARE_CODE
  MANUAL_DOCUMENT_CHECK
  EMPLOYER_PORTAL
  RE_VERIFICATION
  OTHER
}

model WorkerChangeLog {
  id            String   @id @default(cuid())
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  changeCategory ChangeCategory
  summary       String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  effectiveDate DateTime?
  tenantId      String
  createdByUserId String
  createdAt     DateTime @default(now())

  @@index([workerId])
  @@index([tenantId])
}

enum ChangeCategory {
  ADDRESS
  VISA
  CONTRACT
  PHONE_EMAIL
  CONTACT
  SALARY
  WORK_LOCATION
  ROLE_TITLE
  PROMOTION
  ABSENCE

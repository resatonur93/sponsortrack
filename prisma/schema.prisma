generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(cuid())
  companyName   String
  licenceNumber String   @unique
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  users         User[]
  workers       Worker[]
  notifications NotificationEvent[]
  complianceEvents ComplianceEvent[]
  alerts        Alert[]
  documents     Document[]
  documentVaults DocumentVault[]
  auditLogs     AuditLog[]
  orgChanges    OrgChange[]
  roleCompliances RoleCompliance[]
  salaryRecords   SalaryRecord[]
}

model User {
  id        String   @id @default(cuid())
  email     String
  password  String
  firstName String
  lastName  String
  role      Role
  isActive  Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  assignedLeads  Lead[]         @relation("LeadAssignee")
  leadActivities LeadActivity[]
  managedWorkers Worker[]       @relation("LineManager")

  @@unique([email])
  @@index([tenantId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  CONVERTED
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  email       String
  companyName String?
  name        String?
  phone       String?
  message     String?    @db.Text
  source      String
  status      LeadStatus @default(NEW)
  assignedTo  String?
  assignee    User?      @relation("LeadAssignee", fields: [assignedTo], references: [id])
  notes       String?    @db.Text
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  submitterIp String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  LeadActivity[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([isDeleted])
  @@index([submitterIp, createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  message   String?  @db.Text
  metadata  Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// SYSTEM_ADMIN: platform yöneticisi — tüm kiracılardaki kullanıcıları listeler.
enum Role {
  AUTHORISING_OFFICER
  LEVEL_1_USER
  LEVEL_2_USER
  SYSTEM_ADMIN
}

model Worker {
  id                        String   @id @default(cuid())
  firstName                 String
  lastName                  String
  email                     String
  phone                     String?
  workPhone                 String?
  personalEmail             String?
  nationality               String
  dateOfBirth               DateTime?
  passportNumber            String?
  brpNumber                 String?
  nationalInsuranceNumber   String?
  visaType                  String
  cosReference              String
  cosAssignDate             DateTime
  cosExpiryDate             DateTime
  visaStartDate             DateTime?
  visaExpiryDate            DateTime?
  jobTitle                  String
  occupationCode            String
  jobDescription            String?  @db.Text
  contractJobDescription    String?  @db.Text
  actualDayToDayDuties      String?  @db.Text
  occupationCodeJustification String? @db.Text
  salary                    Int
  workLocation              String
  employmentStatus          EmploymentStatus @default(PENDING_START)
  employmentStartDate       DateTime?
  lineManagerId             String?
  lineManager               User?    @relation("LineManager", fields: [lineManagerId], references: [id])
  lineManagerName           String?
  lineManagerEmail          String?
  currentAddress            String?  @db.Text
  emergencyContact          String?
  emergencyPhone            String?
  rightToWorkLastCheckedAt  DateTime?
  isOffshoreWorker          Boolean  @default(false)
  vesselName                String?
  sponsorshipStartDate      DateTime?
  sponsorshipEndDate        DateTime?
  complianceRiskLevel       ComplianceRiskLevel @default(LOW)
  tenantId                  String
  tenant                    Tenant   @relation(fields: [tenantId], references: [id])
  notifications             NotificationEvent[]
  complianceEvents          ComplianceEvent[]
  alerts                    Alert[]
  documents                 Document[]
  documentVaults            DocumentVault[]
  changeLogs                WorkerChangeLog[]
  absences                  AbsenceRecord[]
  rtwChecks                 RightToWorkCheck[]
  salaryHistory             SalaryHistory[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  requiresAtasCertificate   Boolean  @default(false)
  preRegistrationNurse    Boolean  @default(false)
  roleCompliance            RoleCompliance?
  salaryRecords             SalaryRecord[]

  @@unique([cosReference, tenantId])
  @@index([visaExpiryDate])
  @@index([employmentStatus])
  @@index([tenantId])
  @@index([lineManagerId])
}

model RoleCompliance {
  id                      String   @id @default(cuid())
  workerId                String   @unique
  worker                  Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  cosJobDescription       String   @db.Text
  cosOccupationCode       String
  contractDuties          String   @db.Text
  internalJobDesc         String?  @db.Text
  actualDuties            String?  @db.Text
  lastReviewed            DateTime?
  reviewedBy              String?

  mismatchFlags           String[] @default([])
  needsChangeOfEmployment Boolean  @default(false)

  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
}

model SalaryRecord {
  id                  String   @id @default(cuid())
  workerId            String
  worker              Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  periodStart         DateTime
  periodEnd           DateTime
  contractedSalary    Int
  actualPaid          Int
  currency            String   @default("GBP")
  hoursWorked         Int?
  overtime            Int?
  deductions          Json?
  isCompliant         Boolean
  discrepancyReason   String?
  evidenceUrl         String?
  approvedBy          String?
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  createdAt           DateTime @default(now())

  @@index([workerId])
  @@index([tenantId])
  @@index([periodEnd])
  @@index([isCompliant])
  @@index([tenantId, isCompliant])
}

enum ComplianceRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmploymentStatus {
  PENDING_START
  ACTIVE
  SUSPENDED
  TERMINATED
}

model ComplianceEvent {
  id               String      @id @default(cuid())
  workerId         String
  worker           Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  eventType        EventType
  eventDate        DateTime
  reportDeadline   DateTime
  status           EventStatus @default(PENDING)
  evidenceRequired String[]    @default([])
  smsDraft         String?     @db.Text
  approvedBy       String?
  reportedDate     DateTime?
  notes            String?     @db.Text
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  createdAt        DateTime    @default(now())

  @@index([status, reportDeadline])
  @@index([workerId])
  @@index([tenantId])
}

enum EventType {
  NO_SHOW_28_DAYS
  UNAUTHORISED_ABSENCE_10_DAYS
  REDUCED_PAY_ABSENCE
  SALARY_REDUCTION
  ROLE_CHANGE
  PROMOTION_SAME_CODE
  WORK_LOCATION_CHANGE
  SPONSORSHIP_ENDED
  OFFSHORE_ARRIVAL
  OFFSHORE_DEPARTURE
  ADDRESS_CHANGE
  PHONE_CHANGE
  EMAIL_CHANGE
}

enum EventStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REPORTED
  OVERDUE
  CANCELLED
}

model Alert {
  id          String     @id @default(cuid())
  workerId    String?
  worker      Worker?    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  alertType   AlertType
  level       AlertLevel
  message     String
  dedupeKey   String
  isRead      Boolean    @default(false)
  dismissedAt DateTime?
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  createdAt   DateTime   @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, level, isRead])
  @@index([workerId])
}

enum AlertType {
  DEADLINE_APPROACHING
  DEADLINE_OVERDUE
  MISSING_DOCUMENT
  SALARY_MISMATCH
  VISA_EXPIRING
  ROLE_CODE_MISMATCH
  UNEXPLAINED_ABSENCE
  ORG_CHANGE_PENDING
}

enum AlertLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model NotificationEvent {
  id                 String             @id @default(cuid())
  eventType          NotificationType
  workerId           String
  worker             Worker             @relation(fields: [workerId], references: [id])
  idempotencyKey     String             @unique
  dueDate            DateTime
  occurredAt         DateTime?
  reportDeadlineAt   DateTime?
  status             NotificationStatus @default(PENDING)
  reportedDate       DateTime?
  notes              String?
  metadata           Json?
  evidenceRequired   String?            @db.Text
  smsDraft           String?            @db.Text
  internalApprovalNote String?          @db.Text
  approverRole       Role?
  reminderStage      Int                @default(0)
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  documents          Document[]         @relation("ComplianceDocuments")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, dueDate])
  @@index([reportDeadlineAt])
  @@index([workerId, eventType, status])
  @@index([tenantId])
}

enum NotificationType {
  NO_SHOW
  UNAUTHORISED_ABSENCE
  UNPAID_OR_REDUCED_PAY_ABSENCE
  SALARY_REDUCTION
  CHANGE_OF_ROLE_OR_DUTIES
  PROMOTION_SAME_SOC
  WORK_LOCATION_CHANGE
  SPONSORSHIP_ENDED
  OFFSHORE_ARRIVAL
  OFFSHORE_DEPARTURE
  ORGANISATION_CHANGE
  ADDRESS_CONTACT_UPDATE
  ORGANISATION_SIZE_CHANGE
  CHARITY_STATUS_CHANGE
  KEY_PERSONNEL_CHANGE
  MERGER_TUPE_RESTRUCTURING
  INSOLVENCY_RELATED
  VISA_EXPIRING_90_DAYS
  VISA_EXPIRING_30_DAYS
  VISA_EXPIRING_7_DAYS
  DOCUMENT_EXPIRING
  WORKER_MISSING_DOCUMENTS
  SALARY_DISCREPANCY
}

enum NotificationStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

model Document {
  id                  String         @id @default(cuid())
  workerId            String
  worker              Worker         @relation(fields: [workerId], references: [id])
  documentType      DocumentType
  vaultFolder         DocumentVaultFolder @default(OTHER)
  fileName            String
  fileUrl             String
  fileData            String?        @db.Text
  metadata            Json?
  version             Int            @default(1)
  replacesDocumentId  String?
  replaces            Document?      @relation("DocumentVersions", fields: [replacesDocumentId], references: [id])
  laterVersions       Document[]     @relation("DocumentVersions")
  uploadDate          DateTime       @default(now())
  expiryDate          DateTime?
  retentionUntil      DateTime?
  verifiedAt          DateTime?
  verifiedByUserId    String?
  verificationNote    String?        @db.Text
  uploadedBy          String
  isDeleted           Boolean        @default(false)
  deletedAt           DateTime?
  deletedReason       String?
  complianceEventId   String?
  complianceEvent     NotificationEvent? @relation("ComplianceDocuments", fields: [complianceEventId], references: [id])
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])

  @@index([workerId])
  @@index([retentionUntil])
  @@index([tenantId])
  @@index([vaultFolder])
  @@index([complianceEventId])
}

model DocumentVault {
  id               String         @id @default(cuid())
  workerId         String
  worker           Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  folder           DocumentFolder
  fileName         String
  fileUrl          String
  fileData         String?        @db.Text
  version          Int            @default(1)
  previousVersions Json?
  uploadedBy       String
  expiryDate       DateTime?
  retentionUntil   DateTime?
  isDeleted        Boolean        @default(false)
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workerId])
  @@index([tenantId])
  @@index([folder])
  @@index([isDeleted])
}

enum DocumentFolder {
  IDENTITY_IMMIGRATION
  RIGHT_TO_WORK
  COS_APPLICATION
  EMPLOYMENT_CONTRACT
  PAYROLL_SALARY
  ABSENCE_LEAVE
  ADDRESS_CONTACT
  ROLE_DUTIES
  RECRUITMENT_VACANCY
  REPORTING_SUBMISSIONS
  COMPLIANCE_VISIT_PACK
}

enum DocumentVaultFolder {
  IDENTITY_IMMIGRATION
  RIGHT_TO_WORK
  COS_APPLICATION
  EMPLOYMENT_CONTRACT
  PAYROLL_SALARY
  ABSENCE_LEAVE
  ADDRESS_CONTACT
  ROLE_ORG_CHART
  RECRUITMENT_VACANCY
  REPORTING_SUBMISSIONS
  COMPLIANCE_VISIT_PACK
  OTHER
}

enum DocumentType {
  PASSPORT
  BRP
  EVISA
  SHARE_CODE
  VISA
  COS
  ATAS_CERTIFICATE
  DBS_CHECK
  EMPLOYMENT_CONTRACT
  QUALIFICATION
  PROFESSIONAL_REGISTRATION
  RIGHT_TO_WORK
  PROOF_OF_ADDRESS
  NMC_REGISTRATION
  VESSEL_ASSIGNMENT_LETTER
}

model RightToWorkCheck {
  id               String          @id @default(cuid())
  workerId         String
  worker           Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  checkedAt        DateTime        @default(now())
  checkMethod      RtwCheckMethod
  outcomeSummary   String?         @db.Text
  shareCodeUsed    String?
  notes            String?         @db.Text
  evidenceDocumentId String?
  nextCheckDueAt   DateTime?
  tenantId         String
  createdByUserId  String
  createdAt        DateTime        @default(now())

  @@index([workerId])
  @@index([tenantId])
  @@index([checkedAt])
}

enum RtwCheckMethod {
  ONLINE_SHARE_CODE
  MANUAL_DOCUMENT_CHECK
  EMPLOYER_PORTAL
  RE_VERIFICATION
  OTHER
}

model WorkerChangeLog {
  id            String   @id @default(cuid())
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  changeCategory ChangeCategory
  summary       String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  effectiveDate DateTime?
  tenantId      String
  createdByUserId String
  createdAt     DateTime @default(now())

  @@index([workerId])
  @@index([tenantId])
}

enum ChangeCategory {
  ADDRESS
  PHONE_EMAIL
  SALARY
  WORK_LOCATION
  ROLE_TITLE
  PROMOTION
  ABSENCE
  OTHER
}

model AbsenceRecord {
  id                   String         @id @default(cuid())
  workerId             String
  worker               Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  startDate            DateTime
  endDate              DateTime?
  /// Maps to DB column `absenceType` (avoids reserved `type` name + matches existing migrations).
  type                 AbsenceType    @default(UNAUTHORISED) @map("absenceType")
  status               AbsenceStatus  @default(ACTIVE)
  isAuthorised         Boolean
  approvedBy           String?
  reason               String?
  notes                String?        @db.Text
  contactAttempts      Json?
  returnToWorkDate     DateTime?
  returnToWorkNotes    String?
  consecutiveWorkingDays Int?
  isReportable         Boolean        @default(false)
  tenantId             String
  createdAt            DateTime       @default(now())

  @@index([workerId])
  @@index([tenantId])
  @@index([isReportable])
}

enum AbsenceType {
  SICK
  ANNUAL_LEAVE
  UNAUTHORISED
  SUSPENDED
  MATERNITY_PATERNITY
  OTHER
}

enum AbsenceStatus {
  ACTIVE
  RETURNED
  TERMINATED
  CONVERTED_TO_LEAVE
}

model SalaryHistory {
  id              String   @id @default(cuid())
  workerId        String
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  tenantId        String
  effectiveDate   DateTime
  oldSalary       Int
  newSalary       Int
  reason          String?  @db.Text
  justification   String?  @db.Text
  approvedBy      String?
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([workerId])
  @@index([tenantId])
  @@index([effectiveDate])
}

model OrgChange {
  id                 String          @id @default(cuid())
  changeType         OrgChangeType
  description        String          @db.Text
  effectiveDate      DateTime
  status             OrgChangeStatus   @default(PENDING)
  reportedToHO       Boolean         @default(false)
  hoReportDate       DateTime?
  hoReportDeadline   DateTime
  evidenceDocuments  String[]        @default([])
  approvedBy         String?
  notes              String?         @db.Text
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  createdAt          DateTime        @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([hoReportDeadline])
  @@map("OrganisationChange")
}

enum OrgChangeType {
  COMPANY_SIZE_CHANGE
  CHARITY_STATUS_CHANGE
  KEY_PERSONNEL_CHANGE
  BRANCH_OPEN_CLOSE
  MERGER
  TAKEOVER
  TUPE_TRANSFER
  RESTRUCTURING
  INSOLVENCY
  ADMINISTRATION
  LIQUIDATION
  CVA
  ADDRESS_CHANGE
  NAME_CHANGE
}

enum OrgChangeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REPORTED
  OVERDUE
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  changes     Json?
  performedBy String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([entityType, entityId])
  @@index([tenantId, createdAt])
}

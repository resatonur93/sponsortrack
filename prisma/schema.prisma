model AbsenceRecord {
  id                   String         @id @default(cuid())
  workerId             String
  worker               Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  startDate            DateTime
  endDate              DateTime?
  /// Maps to DB column `absenceType` (avoids reserved `type` name + matches existing migrations).
  type                 AbsenceType    @default(UNAUTHORISED) @map("absenceType")
  status               AbsenceStatus  @default(ACTIVE)
  isAuthorised         Boolean
  approvedBy           String?
  reason               String?
  notes                String?        @db.Text
  contactAttempts      Json?
  returnToWorkDate     DateTime?
  returnToWorkNotes    String?
  consecutiveWorkingDays Int?
  isReportable         Boolean        @default(false)
  tenantId             String
  createdAt            DateTime       @default(now())

  @@index([workerId])
  @@index([tenantId])
  @@index([isReportable])
}

enum AbsenceType {
  SICK
  ANNUAL_LEAVE
  UNAUTHORISED
  SUSPENDED
  MATERNITY_PATERNITY
  OTHER
}

enum AbsenceStatus {
  ACTIVE
  RETURNED
  TERMINATED
  CONVERTED_TO_LEAVE
}

model SalaryHistory {
  id              String   @id @default(cuid())
  workerId        String
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  tenantId        String
  effectiveDate   DateTime

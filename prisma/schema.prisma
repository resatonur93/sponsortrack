generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(cuid())
  companyName   String
  licenceNumber String   @unique
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  users         User[]
  workers       Worker[]
  notifications NotificationEvent[]
  complianceEvents ComplianceEvent[]
  smsReportDrafts SmsReportDraft[]
  alerts        Alert[]
  documents     Document[]
  documentVaults DocumentVault[]
  auditLogs     AuditLog[]
  orgChanges    OrgChange[]
  roleCompliances RoleCompliance[]
  salaryRecords   SalaryRecord[]
  riskScores      RiskScore[]
  workflowSteps   WorkflowStep[]
  ukLawChecks     UkLawCheck[]
  policies        Policy[]
  acknowledgements Acknowledgement[]
  documentExpiryEmailLogs DocumentExpiryEmailLog[]
  notificationEmailLogs NotificationEmailLog[]
  leadFormSettings      LeadFormSettings?
  securitySettings      TenantSecuritySettings?
  allowedIpRules        AllowedIpRule[]
  authSessions          UserAuthSession[]
  trustedDevices        UserTrustedDevice[]
  notificationConfig    NotificationConfig?
  emailTemplates        EmailTemplate[]
}

/// Kiracı başına otomatik uyum / belge e-posta hatırlatıcı takvimi ve dağıtım listeleri.
model NotificationConfig {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  emailEnabled Boolean @default(true)
  /// Virgülle ayrılmış ek CC adresleri (AO + yöneticiler `to` ile çözümlenmeye devam eder).
  ccRecipients  String? @db.Text
  bccRecipients String? @db.Text

  sendAfterExpired Boolean @default(true)

  visaRemind60Enabled      Boolean @default(true)
  visaRemind60Days         Int     @default(60)
  visaRemind30Enabled      Boolean @default(true)
  visaRemind30Days         Int     @default(30)
  visaRemind7Enabled       Boolean @default(true)
  visaRemind7Days          Int     @default(7)
  visaRemindLastDayEnabled Boolean @default(true)

  sponsorshipRemind60Enabled      Boolean @default(true)
  sponsorshipRemind60Days         Int     @default(60)
  sponsorshipRemind30Enabled      Boolean @default(true)
  sponsorshipRemind30Days         Int     @default(30)
  sponsorshipRemind7Enabled       Boolean @default(true)
  sponsorshipRemind7Days          Int     @default(7)
  sponsorshipRemindLastDayEnabled Boolean @default(false)

  rtwRemind60Enabled      Boolean @default(true)
  rtwRemind60Days         Int     @default(60)
  rtwRemind30Enabled      Boolean @default(true)
  rtwRemind30Days         Int     @default(30)
  rtwRemind7Enabled       Boolean @default(true)
  rtwRemind7Days          Int     @default(7)
  rtwRemindLastDayEnabled Boolean @default(false)

  documentRemind60Enabled      Boolean @default(true)
  documentRemind60Days         Int     @default(60)
  documentRemind30Enabled      Boolean @default(true)
  documentRemind30Days         Int     @default(30)
  documentRemind7Enabled       Boolean @default(true)
  documentRemind7Days          Int     @default(7)
  documentRemindLastDayEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model EmailTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateKey   String
  subjectTr     String
  subjectEn     String
  bodyTr        String   @db.Text
  bodyEn        String   @db.Text
  variableHints String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, templateKey])
  @@index([tenantId])
}

model User {
  id        String   @id @default(cuid())
  email     String
  password  String
  firstName String
  lastName  String
  role      Role
  isActive  Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  assignedLeads  Lead[]         @relation("LeadAssignee")
  leadActivities LeadActivity[]
  managedWorkers Worker[]       @relation("LineManager")
  workflowStepsAssigned WorkflowStep[] @relation("WorkflowStepAssignee")
  workflowStepsActioned WorkflowStep[] @relation("WorkflowStepActionedBy")
  policyAcknowledgements Acknowledgement[]
  authSessions           UserAuthSession[]
  trustedDevices         UserTrustedDevice[]

  @@unique([email])
  @@index([tenantId])
}

/// AO tarafından yönetilen kiracı güvenlik parametreleri.
model TenantSecuritySettings {
  id                        String   @id @default(cuid())
  tenantId                  String   @unique
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Yalnızca tanımlı IP aralıklarından giriş (SYSTEM_ADMIN için istisna)
  enforceIpWhitelist        Boolean  @default(false)
  /// Sunucuda son aktiviteden sonra oturumu geçersiz sayma (dk); null → denetimsiz bu kural yoktur
  sessionIdleTimeoutMinutes Int?
  /// Oturum kaydı oluşturulmasından sonra maks süre (dk); JWT’den bağımsız ek sınır
  sessionAbsoluteMaxMinutes Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([tenantId])
}

model AllowedIpRule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String
  /// Tek IPv4, "10.1.2.3" veya CIDR örn "10.0.0.0/24"; IPv6 şimdilik düz adres eşleşmesi
  cidr      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, sortOrder])
}

/// İzlenen tarayıcı oturumları (JWT `authSid` ile eşleşir).
model UserAuthSession {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String    @unique
  userAgent    String?   @db.Text
  deviceLabel  String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?

  @@index([tenantId, userId, revokedAt])
  @@index([lastSeenAt])
}

/// Kullanıcı + tarayıcı parmak izi (User-Agent hash) bazlı cihaz kaydı.
model UserTrustedDevice {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint  String
  label        String
  trusted      Boolean   @default(false)
  lastIp       String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  trustedAt    DateTime?

  @@unique([userId, fingerprint])
  @@index([tenantId])
}

enum PolicyCategory {
  SPONSOR_DUTIES
  IMMIGRATION_RULES
  COMPLIANCE_GUIDANCE
  DATA_PROTECTION
  EMPLOYMENT_LAW
  TRAINING_MATERIAL
}

model Policy {
  id                        String         @id @default(cuid())
  title                     String
  content                   String         @db.Text
  version                   String
  effectiveDate             DateTime
  category                  PolicyCategory
  isAcknowledgementRequired Boolean        @default(false)
  // Optional HTTPS URL to a hosted PDF or attachment (body can summarise).
  fileUrl                   String?
  tenantId                  String
  tenant                    Tenant         @relation(fields: [tenantId], references: [id])
  acknowledgements          Acknowledgement[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([tenantId])
  @@index([category])
}

model Acknowledgement {
  id             String   @id @default(cuid())
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([policyId, userId])
  @@index([tenantId])
  @@index([userId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  CONVERTED
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  email       String
  companyName String?
  name        String?
  phone       String?
  message     String?    @db.Text
  source      String
  status      LeadStatus @default(NEW)
  assignedTo  String?
  assignee    User?      @relation("LeadAssignee", fields: [assignedTo], references: [id])
  notes       String?    @db.Text
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  submitterIp String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  LeadActivity[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([isDeleted])
  @@index([submitterIp, createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  message   String?  @db.Text
  metadata  Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// Kiracı başına tek satır — manuel/yerleşik lead formları için alan ve kaynak yapılandırması.
model LeadFormSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields    LeadFormField[]
  sources   LeadFormSourceOption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Sabit anahtarlardan biri: firstName | lastName | email | phone | company | source | message
model LeadFormField {
  id          String           @id @default(cuid())
  settingsId  String
  settings    LeadFormSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  sortOrder   Int              @default(0)
  fieldKey    String
  label       String
  placeholder String?
  enabled     Boolean          @default(true)
  required    Boolean          @default(false)
  /// { minLength?, maxLength?, pattern?, enforceEmail?, phoneIntl? }
  validation  Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([settingsId, fieldKey])
  @@index([settingsId, sortOrder])
}

model LeadFormSourceOption {
  id         String           @id @default(cuid())
  settingsId String
  settings   LeadFormSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  sortOrder  Int              @default(0)
  value      String
  label      String
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([settingsId, value])
  @@index([settingsId, sortOrder])
}

// SYSTEM_ADMIN: platform yöneticisi — tüm kiracılardaki kullanıcıları listeler.
enum Role {
  AUTHORISING_OFFICER
  LEVEL_1_USER
  LEVEL_2_USER
  SYSTEM_ADMIN
}

model Worker {
  id                        String   @id @default(cuid())
  firstName                 String
  lastName                  String
  email                     String
  phone                     String?
  workPhone                 String?
  personalEmail             String?
  nationality               String
  dateOfBirth               DateTime?
  passportNumber            String?
  brpNumber                 String?
  nationalInsuranceNumber   String?
  visaType                  String
  cosReference              String
  cosAssignDate             DateTime
  cosExpiryDate             DateTime
  visaStartDate             DateTime?
  visaExpiryDate            DateTime?
  jobTitle                  String
  occupationCode            String
  jobDescription            String?  @db.Text
  contractJobDescription    String?  @db.Text
  actualDayToDayDuties      String?  @db.Text
  occupationCodeJustification String? @db.Text
  salary                    Int
  workLocation              String
  employmentStatus          EmploymentStatus @default(PENDING_START)
  employmentStartDate       DateTime?
  lineManagerId             String?
  lineManager               User?    @relation("LineManager", fields: [lineManagerId], references: [id])
  lineManagerName           String?
  lineManagerEmail          String?
  currentAddress            String?  @db.Text
  emergencyContact          String?
  emergencyPhone            String?
  rightToWorkLastCheckedAt  DateTime?
  isOffshoreWorker          Boolean  @default(false)
  vesselName                String?
  sponsorshipStartDate      DateTime?
  sponsorshipEndDate        DateTime?
  complianceRiskLevel       ComplianceRiskLevel @default(LOW)
  tenantId                  String
  tenant                    Tenant   @relation(fields: [tenantId], references: [id])
  notifications             NotificationEvent[]
  complianceEvents          ComplianceEvent[]
  alerts                    Alert[]
  documents                 Document[]
  documentVaults            DocumentVault[]
  changeLogs                WorkerChangeLog[]
  absences                  AbsenceRecord[]
  rtwChecks                 RightToWorkCheck[]
  salaryHistory             SalaryHistory[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  requiresAtasCertificate   Boolean  @default(false)
  preRegistrationNurse    Boolean  @default(false)
  roleCompliance            RoleCompliance?
  salaryRecords             SalaryRecord[]
  riskScores                RiskScore[]
  ukLawCheck                UkLawCheck?

  @@unique([cosReference, tenantId])
  @@index([visaExpiryDate])
  @@index([employmentStatus])
  @@index([tenantId])
  @@index([lineManagerId])
  @@index([tenantId, employmentStatus, visaExpiryDate])
}

model UkLawCheck {
  id                String    @id @default(cuid())
  workerId          String    @unique
  worker            Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  nmwCompliant      Boolean?
  hourlyRate        Decimal?  @db.Decimal(12, 4)
  hoursPerWeek      Decimal?  @db.Decimal(10, 2)

  weeklyHours       Decimal?  @db.Decimal(10, 2)
  maxWeeklyHours    Decimal   @default(48) @db.Decimal(10, 2)
  optOutSigned      Boolean   @default(false)

  annualEntitlement Decimal   @default(28) @db.Decimal(10, 2)
  daysTaken         Decimal?  @db.Decimal(10, 2)
  daysRemaining     Decimal?  @db.Decimal(10, 2)

  contractIssued    DateTime?
  contractType      String    @default("permanent")

  flags             String[]  @default([])

  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
}

model RoleCompliance {
  id                      String   @id @default(cuid())
  workerId                String   @unique
  worker                  Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  cosJobDescription       String   @db.Text
  cosOccupationCode       String
  contractDuties          String   @db.Text
  internalJobDesc         String?  @db.Text
  actualDuties            String?  @db.Text
  lastReviewed            DateTime?
  reviewedBy              String?

  mismatchFlags           String[] @default([])
  needsChangeOfEmployment Boolean  @default(false)

  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
}

model SalaryRecord {
  id                  String   @id @default(cuid())
  workerId            String
  worker              Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  periodStart         DateTime
  periodEnd           DateTime
  contractedSalary    Int
  actualPaid          Int
  currency            String   @default("GBP")
  hoursWorked         Int?
  overtime            Int?
  deductions          Json?
  isCompliant         Boolean
  discrepancyReason   String?
  evidenceUrl         String?
  approvedBy          String?
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  createdAt           DateTime @default(now())

  @@index([workerId])
  @@index([tenantId])
  @@index([periodEnd])
  @@index([isCompliant])
  @@index([tenantId, isCompliant])
}

enum ComplianceRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Engine output tier (0–20 LOW … 81+ CRITICAL)
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmploymentStatus {
  PENDING_START
  ACTIVE
  SUSPENDED
  TERMINATED
}

model ComplianceEvent {
  id               String      @id @default(cuid())
  workerId         String
  worker           Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  eventType        EventType
  eventDate        DateTime
  reportDeadline   DateTime
  status           EventStatus @default(PENDING)
  workflowState    EventWorkflowState @default(DRAFT)
  evidenceRequired String[]    @default([])
  smsDraft         String?     @db.Text
  approvedBy       String?
  reportedDate     DateTime?
  notes            String?     @db.Text
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  createdAt        DateTime    @default(now())
  smsReportDrafts  SmsReportDraft[]
  workflowSteps    WorkflowStep[]

  @@index([status, reportDeadline])
  @@index([workerId])
  @@index([tenantId])
  @@index([workflowState])
}

model WorkflowStep {
  id          String             @id @default(cuid())
  eventId     String
  event       ComplianceEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  step        WorkflowStepType
  status      WorkflowStepStatus @default(PENDING)
  assignedTo  String
  assignee    User               @relation("WorkflowStepAssignee", fields: [assignedTo], references: [id])
  actionedBy  String?
  actionedByUser User?           @relation("WorkflowStepActionedBy", fields: [actionedBy], references: [id])
  actionedAt  DateTime?
  notes       String?            @db.Text
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  createdAt   DateTime           @default(now())

  @@index([tenantId])
  @@index([eventId])
  @@index([assignedTo])
  @@index([status])
}

model SmsReportDraft {
  id                  String          @id @default(cuid())
  eventId             String
  event               ComplianceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  smsText             String          @db.Text
  evidenceChecklist   String[]        @default([])
  deadline            DateTime
  internalNotes       String?         @db.Text
  generatedBy         String
  approvedBy          String?
  approvedAt          DateTime?
  sentToHO            Boolean         @default(false)
  sentAt              DateTime?
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  createdAt           DateTime        @default(now())

  @@index([tenantId])
  @@index([eventId])
  @@index([createdAt])
}

enum EventType {
  NO_SHOW_28_DAYS
  UNAUTHORISED_ABSENCE_10_DAYS
  REDUCED_PAY_ABSENCE
  SALARY_REDUCTION
  ROLE_CHANGE
  PROMOTION_SAME_CODE
  WORK_LOCATION_CHANGE
  SPONSORSHIP_ENDED
  OFFSHORE_ARRIVAL
  OFFSHORE_DEPARTURE
  ADDRESS_CHANGE
  PHONE_CHANGE
  EMAIL_CHANGE
}

enum EventStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REPORTED
  OVERDUE
  CANCELLED
}

enum EventWorkflowState {
  DRAFT
  SUBMITTED
  MANAGER_REVIEW
  COMPLIANCE_REVIEW
  AO_APPROVAL
  REPORTED
}

enum WorkflowStepType {
  HR_SUBMISSION
  MANAGER_REVIEW
  COMPLIANCE_REVIEW
  AO_APPROVAL
  FINAL_REPORT
}

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  ESCALATED
}

model Alert {
  id          String     @id @default(cuid())
  workerId    String?
  worker      Worker?    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  alertType   AlertType
  level       AlertLevel
  message     String
  dedupeKey   String
  isRead      Boolean    @default(false)
  dismissedAt DateTime?
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  createdAt   DateTime   @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, level, isRead])
  @@index([workerId])
  @@index([tenantId, workerId, alertType])
}

enum AlertType {
  DEADLINE_APPROACHING
  DEADLINE_OVERDUE
  MISSING_DOCUMENT
  SALARY_MISMATCH
  VISA_EXPIRING
  ROLE_CODE_MISMATCH
  UNEXPLAINED_ABSENCE
  ORG_CHANGE_PENDING
}

enum AlertLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model NotificationEvent {
  id                 String             @id @default(cuid())
  eventType          NotificationType
  workerId           String
  worker             Worker             @relation(fields: [workerId], references: [id])
  idempotencyKey     String             @unique
  dueDate            DateTime
  occurredAt         DateTime?
  reportDeadlineAt   DateTime?
  status             NotificationStatus @default(PENDING)
  reportedDate       DateTime?
  notes              String?
  metadata           Json?
  evidenceRequired   String?            @db.Text
  smsDraft           String?            @db.Text
  internalApprovalNote String?          @db.Text
  approverRole       Role?
  reminderStage      Int                @default(0)
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  documents          Document[]         @relation("ComplianceDocuments")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  /// Inbox “okundu” — tamamlandı aksiyonundan bağımsız; listede gürültü azaltmak için.
  readAt             DateTime?

  @@index([status, dueDate])
  @@index([reportDeadlineAt])
  @@index([workerId, eventType, status])
  @@index([tenantId])
  @@index([tenantId, readAt])
  @@index([tenantId, status, eventType])
}

enum NotificationType {
  NO_SHOW
  UNAUTHORISED_ABSENCE
  UNPAID_OR_REDUCED_PAY_ABSENCE
  SALARY_REDUCTION
  CHANGE_OF_ROLE_OR_DUTIES
  PROMOTION_SAME_SOC
  WORK_LOCATION_CHANGE
  SPONSORSHIP_ENDED
  OFFSHORE_ARRIVAL
  OFFSHORE_DEPARTURE
  ORGANISATION_CHANGE
  ADDRESS_CONTACT_UPDATE
  ORGANISATION_SIZE_CHANGE
  CHARITY_STATUS_CHANGE
  KEY_PERSONNEL_CHANGE
  MERGER_TUPE_RESTRUCTURING
  INSOLVENCY_RELATED
  /// Legacy Postgres label; migrate rows to VISA_EXPIRING_60_DAYS when possible
  VISA_EXPIRING_90_DAYS
  VISA_EXPIRING_60_DAYS
  VISA_EXPIRING_30_DAYS
  VISA_EXPIRING_7_DAYS
  RIGHT_TO_WORK_RECHECK_60_DAYS
  RIGHT_TO_WORK_RECHECK_30_DAYS
  RIGHT_TO_WORK_RECHECK_7_DAYS
  SPONSORSHIP_ENDING_60_DAYS
  SPONSORSHIP_ENDING_30_DAYS
  SPONSORSHIP_ENDING_7_DAYS
  DOCUMENT_EXPIRING
  WORKER_MISSING_DOCUMENTS
  SALARY_DISCREPANCY
}

enum NotificationStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum DocumentComplianceRecordStatus {
  UPLOADED
  VERIFIED
}

model Document {
  id                  String         @id @default(cuid())
  workerId            String
  worker              Worker         @relation(fields: [workerId], references: [id])
  documentType      DocumentType
  vaultFolder         DocumentFolder @default(OTHER)
  fileName            String
  fileUrl             String
  mimeType            String?
  sizeBytes           Int?
  fileHash            String?
  metadata            Json?
  version             Int            @default(1)
  replacesDocumentId  String?
  replaces            Document?      @relation("DocumentVersions", fields: [replacesDocumentId], references: [id])
  laterVersions       Document[]     @relation("DocumentVersions")
  /// Physical file in the worker vault (S3/Supabase); null when created only via /api/documents.
  vaultFileId         String?        @unique @map("vault_file_id")
  vaultSource         DocumentVault? @relation("VaultComplianceMirror", fields: [vaultFileId], references: [id], onDelete: SetNull)
  complianceRecordStatus DocumentComplianceRecordStatus @default(UPLOADED) @map("compliance_record_status")
  uploadDate          DateTime       @default(now())
  expiryDate          DateTime?
  retentionUntil      DateTime?
  verifiedAt          DateTime?
  verifiedByUserId    String?
  verificationNote    String?        @db.Text
  uploadedBy          String
  isDeleted           Boolean        @default(false)
  deletedAt           DateTime?
  deletedReason       String?
  complianceEventId   String?
  complianceEvent     NotificationEvent? @relation("ComplianceDocuments", fields: [complianceEventId], references: [id])
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])

  @@index([workerId])
  @@index([retentionUntil])
  @@index([tenantId])
  @@index([vaultFolder])
  @@index([complianceEventId])
  @@index([tenantId, workerId, documentType])
}

// One row per (document, expiry calendar day) after an expiry notification email was sent.
enum DocumentExpiryReminderKind {
  BEFORE_60
  BEFORE_30
  BEFORE_7
  EXPIRY_DAY
  AFTER_EXPIRED
}

model DocumentExpiryEmailLog {
  id         String   @id @default(cuid())
  documentId String
  expiryDay  String
  kind       DocumentExpiryReminderKind @default(AFTER_EXPIRED)
  workerId   String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  sentAt     DateTime @default(now())

  @@unique([documentId, expiryDay, kind])
  @@index([tenantId])
  @@index([tenantId, expiryDay])
}

/// Grouping key for visa / RTW recheck / sponsorship / CoS anchors (distinct from Postgres enum name prefixes).
enum NotificationComplianceAnchorDomain {
  VISA_EXPIRY
  RIGHT_TO_WORK_RECHECK
  SPONSORSHIP_END
  COS_EXPIRY
}

/// Idempotency after a TR+EN SMTP send for sponsor compliance date reminders (cf. DocumentExpiryEmailLog).
model NotificationEmailLog {
  id                  String                             @id @default(cuid())
  tenantId            String
  tenant              Tenant                             @relation(fields: [tenantId], references: [id])
  workerId            String
  /// When the send was driven by `NotificationEvent` (due-day); null for anchor-only cron sends.
  notificationEventId String?
  anchorDomain        NotificationComplianceAnchorDomain
  anchorDay           String
  reminderKind        DocumentExpiryReminderKind
  sentAt              DateTime                           @default(now())

  @@unique([workerId, anchorDomain, anchorDay, reminderKind])
  @@index([tenantId])
  @@index([notificationEventId])
}

model DocumentVault {
  id               String         @id @default(cuid())
  workerId         String
  worker           Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  folder           DocumentFolder
  fileName         String
  fileUrl          String
  mimeType         String?
  sizeBytes        Int?
  fileHash         String?
  version          Int            @default(1)
  previousVersions Json?
  uploadedBy       String
  expiryDate       DateTime?
  retentionUntil   DateTime?
  isDeleted        Boolean        @default(false)
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// Inverse: at most one compliance Document may reference this vault row (via Document.vaultFileId).
  complianceMirror Document?      @relation("VaultComplianceMirror")

  @@index([workerId])
  @@index([tenantId])
  @@index([folder])
  @@index([isDeleted])
}


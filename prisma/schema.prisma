model RiskScore {
  id                 String    @id @default(cuid())
  workerId           String?
  worker             Worker?   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  /// Organisation-only snapshot (no worker); mutually exclusive with workerId
  isTenantAggregate  Boolean   @default(false)
  score              Int
  level              RiskLevel
  factors            Json
  calculatedAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, level])
  @@index([tenantId, isTenantAggregate])
  @@index([workerId])
  @@index([tenantId, isTenantAggregate, calculatedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  changes     Json?
  performedBy String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([entityType, entityId])
  @@index([tenantId, createdAt])
}

/// Failed login attempts (tenant credentials + self-service worker portal), pre-auth so no tenant context yet.
enum LoginAttemptScope {
  TENANT_USER
  SELF_SERVICE_WORKER
}

model LoginAttempt {
  id        String            @id @default(cuid())
  email     String
  ip        String
  scope     LoginAttemptScope
  createdAt DateTime          @default(now())

  @@index([email, scope, createdAt])
  @@index([ip, scope, createdAt])
}
